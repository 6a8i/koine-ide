{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portugol IDE",
  "version": "0.1.0",
  "identifier": "digital.b-zn.portugol-ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portugol IDE",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "IDE para aprender programação com Portugol",
    "longDescription": "Escreva e execute programas em Portugol Studio (.por) e VisuAlg (.alg) com um editor rápido e leve.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["por"], "name": "Programa Portugol Studio", "description": "Programa Portugol Studio", "role": "Editor" },
      { "ext": ["alg"], "name": "Algoritmo VisuAlg", "description": "Algoritmo VisuAlg", "role": "Editor" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] },
      "wix": { "language": "pt-BR" }
    }
  }
}
