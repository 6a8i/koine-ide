{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koiné IDE",
  "version": "0.1.0",
  "identifier": "digital.b-zn.koine-ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Koiné IDE",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Education",
    "shortDescription": "IDE para aprender programação com pseudocódigo em vários idiomas",
    "longDescription": "Escreva, depure e teste programas em Koiné (.koi), uma linguagem de pseudocódigo com palavras reservadas e interface no seu idioma.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "koi"
        ],
        "name": "Programa Koiné",
        "description": "Programa Koiné",
        "mimeType": "text/x-koine",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
